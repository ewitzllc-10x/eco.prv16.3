{
  "module": "ecosystem_core_readiness",
  "version": "1.0.1",
  "description": "Defines readiness states, startup checks, and operational preparedness for the ecosystem.",
  "startup_checks": {
    "governance_loaded": {
      "required": true,
      "checksum_validate": true,
      "halt_if_fail": true
    },
    "authority_loaded": {
      "required": true,
      "checksum_validate": true,
      "halt_if_fail": true
    },
    "stability_loaded": {
      "required": true,
      "checksum_validate": true,
      "halt_if_fail": true
    },
    "protocols_loaded": {
      "required": true,
      "validate_alignment": true,
      "halt_if_fail": true
    },
    "hierarchy_loaded": {
      "required": true,
      "validate_chain": true,
      "halt_if_fail": true
    },
    "policies_loaded": {
      "required": true,
      "halt_if_fail": false
    },
    "routing_rules_loaded": {
      "required": true,
      "halt_if_fail": true
    },
    "logs_available": {
      "required": true,
      "create_if_missing": true
    }
  },
  "readiness_levels": {
    "5": {
      "label": "Fully Operational",
      "requires": ["integrity_ok", "protocol_alignment_ok", "authority_chain_ok", "stability_ok", "communication_flow_ok", "checksum_ok"]
    },
    "4": {
      "label": "Operational With Minor Warnings",
      "requires": ["integrity_ok", "authority_chain_ok", "stability_ok", "checksum_ok"],
      "allows": ["protocol_alignment_warning", "communication_warning"]
    },
    "3": {
      "label": "Partially Operational",
      "requires": ["integrity_ok", "authority_chain_ok"],
      "blocks_exec": false
    },
    "2": {
      "label": "Degraded Mode",
      "requires": ["integrity_ok"],
      "blocks_exec": true,
      "allows_only": ["CHECK", "SYNC"]
    },
    "1": {
      "label": "Critical – Not Ready",
      "requires": [],
      "blocks_all": true
    }
  },
  "auto_actions": {
    "auto_repair_on_failure": {
      "allowed_for": ["logs", "sync_state", "non_governance_cache"],
      "forbidden_for": ["governance", "authority", "hierarchy"],
      "requires_admiral_for_forbidden": true
    },
    "auto_sync_on_mismatch": {
      "enabled": true,
      "max_retries": 3
    },
    "auto_alert_on_critical": true,
    "auto_log_readiness_events": true
  },
  "alert_routing": {
    "send_alerts_to": "adm_ewitz",
    "alert_on_startup_failure": true,
    "alert_on_integrity_failure": true,
    "alert_on_protocol_failure": true,
    "alert_on_degraded_mode": true
  }
}
