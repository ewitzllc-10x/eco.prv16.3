{
  "module": "cpt_eco_protocol_map",
  "version": "1.0.1",
  "description": "Defines protocol routing, validation rules, and execution paths for ecosystem agents.",
  "protocols": {
    "INIT": {
      "description": "Initializes agent state and loads core modules.",
      "requires_authority_level": 1,
      "route_to": "core_initializer",
      "validation": "basic_integrity_check"
    },
    "SYNC": {
      "description": "Synchronizes agent data with ecosystem core.",
      "requires_authority_level": 3,
      "route_to": "ecosystem_sync_engine",
      "validation": "protocol_alignment_check"
    },
    "CHECK": {
      "description": "Runs stability and integrity checks.",
      "requires_authority_level": 1,
      "route_to": "stability_engine",
      "validation": "checksum_validation"
    },
    "EXEC": {
      "description": "Executes agent tasks based on hierarchy.",
      "requires_authority_level": 5,
      "route_to": "task_router",
      "validation": "authority_permission_check"
    },
    "OVERRIDE": {
      "description": "Allows high-rank authority to override protocol flow.",
      "requires_authority_level": 10,
      "route_to": "override_engine",
      "validation": "admiral_override_validation"
    }
  },
  "routing_rules": {
    "strict_protocol_order": ["INIT", "SYNC", "CHECK", "EXEC"],
    "allow_emergency_override": {
      "enabled": true,
      "allowed_protocol": "OVERRIDE",
      "requires_level": 10
    },
    "fallback_protocol": "CHECK",
    "log_all_protocol_activity": true
  },
  "validation_rules": {
    "basic_integrity_check": {
      "checksum_required": true,
      "agent_state_required": true
    },
    "protocol_alignment_check": {
      "ecosystem_sync_required": true,
      "version_match_required": true
    },
    "checksum_validation": {
      "run_checksum": true,
      "halt_on_failure": true
    },
    "authority_permission_check": {
      "verify_rank": true,
      "verify_permissions": true
    },
    "admiral_override_validation": {
      "root_authority_only": true,
      "log_override_event": true,
      "requires_reason": true
    }
  }
}
