{
  "module": "cpt_eco_stability",
  "version": "1.0.1",
  "description": "Defines ecosystem stability rules, conflict resolution, integrity checks, and recovery behavior.",
  "stability_core": {
    "ecosystem_must_be_stable": true,
    "auto_repair_enabled": true,
    "halt_on_critical_failure": false,
    "halt_only_if_recovery_fails": true,
    "log_all_stability_events": true
  },
  "conflict_resolution": {
    "enabled": true,
    "method": "hierarchical_resolution",
    "fallback": "admiral_override",
    "auto_detect_conflicts": true,
    "resolve_cycles_seconds": 20,
    "max_conflicts_before_alert": 5
  },
  "integrity_checks": {
    "enabled": true,
    "checksum_validation": true,
    "protocol_alignment_required": true,
    "agent_health_monitoring": true,
    "check_interval_seconds": 30,
    "fail_after_consecutive_failures": 3
  },
  "recovery": {
    "auto_recover_agents": true,
    "auto_recover_protocols": true,
    "auto_recover_governance": false,
    "governance_recovery_requires": "admiral_manual_approval",
    "max_recovery_attempts": 5,
    "cooldown_seconds": 10,
    "backoff_multiplier": 2
  },
  "alerts": {
    "send_alerts_to": ["adm_ewitz"],
    "alert_on_conflict": true,
    "alert_on_integrity_failure": true,
    "alert_on_recovery_failure": true,
    "alert_on_governance_recovery_blocked": true
  }
}
