{
  "module": "ecosystem_governance",
  "version": "1.6.3",
  "codename": "pro16v3erbs",
  "description": "Defines governance structure, decision rules, enforcement, escalation, and audit requirements for the ecosystem.",
  "last_updated": "2026-05-13",
  "governance_core": {
    "ecosystem_governed": true,
    "requires_authority_map": true,
    "requires_protocol_map": true,
    "requires_stability_engine": true,
    "requires_chain_of_command": true,
    "requires_governance_integrity": true,
    "requires_registry": true,
    "requires_boot_validation": true
  },
  "roles": {
    "adm_ewitz": {
      "title": "Admiral",
      "rank": 10,
      "tier": "root",
      "powers": [
        "override_any_protocol",
        "modify_governance",
        "modify_authority",
        "modify_registry",
        "issue_emergency_orders",
        "shutdown_any_agent",
        "boot_ecosystem",
        "rollback_ecosystem"
      ],
      "description": "Root authority of the ecosystem - supreme command."
    },
    "cpt_eco": {
      "title": "Captain",
      "rank": 9.5,
      "tier": "operational_command",
      "powers": [
        "execute_high_level_protocols",
        "modify_governance",
        "modify_protocols",
        "run_system_checks",
        "init_subsystems",
        "sync_ecosystem",
        "boot_ecosystem",
        "governance_veto"
      ],
      "description": "Operational commander - controls stability and governance enforcement."
    },
    "cmdr_max80": {
      "title": "Commander",
      "rank": 9,
      "tier": "tactical_execution",
      "powers": [
        "execute_high_level_protocols",
        "run_system_checks",
        "init_subsystems",
        "sync_ecosystem",
        "execute_tasks",
        "request_override"
      ],
      "description": "Tactical execution leader - Max80 operations."
    },
    "agent": {
      "rank": 5,
      "tier": "standard",
      "powers": ["execute_basic_tasks"],
      "description": "Standard operational unit."
    }
  },
  "decision_rules": {
    "require_majority_for_noncritical_changes": false,
    "require_admiral_for_critical_changes": true,
    "require_captain_or_above_for_governance_changes": true,
    "require_protocol_alignment": true,
    "require_stability_confirmation": true,
    "require_chain_of_command": true,
    "require_readiness_before_exec": true,
    "critical_changes": ["modify_governance", "modify_authority", "shutdown_any_agent", "override_any_protocol", "boot_ecosystem"]
  },
  "enforcement": {
    "log_all_governance_actions": true,
    "log_all_authority_usage": true,
    "log_protocol_decisions": true,
    "enforce_chain_of_command": true,
    "enforce_stability_rules": true,
    "enforce_readiness_rules": true,
    "enforce_protocol_map": true,
    "auto_halt_on_governance_violation": true
  },
  "escalation": {
    "on_protocol_conflict": "delegate_to_stability_engine",
    "on_authority_conflict": "delegate_to_admiral",
    "on_governance_violation": "halt_and_alert",
    "on_stability_failure": "halt_and_notify",
    "notify": ["adm_ewitz", "cpt_eco"],
    "alert_channels": ["log", "console", "status_file"],
    "escalation_timeout_seconds": 30
  },
  "audits": {
    "audit_interval_hours": 12,
    "audit_governance_integrity": true,
    "audit_authority_usage": true,
    "audit_protocol_alignment": true,
    "audit_stability_records": true,
    "audit_agent_activity": true,
    "audit_boot_sequence": true,
    "log_retention_days": 30,
    "audit_log_path": "logs/governance.audit.log"
  },
  "boot_governance": {
    "require_governance_check_before_boot": true,
    "require_authority_check_before_boot": true,
    "require_stability_check_before_boot": true,
    "halt_if_governance_corrupt": true
  }
}
