{
  "module": "ecosystem_core_stability",
  "version": "1.6.3",
  "codename": "pro16v3erbs",
  "description": "Defines stability requirements, validation rules, thresholds, and automatic responses for the ecosystem.",
  "last_updated": "2026-05-13",
  "stability_core": {
    "ecosystem_must_be_stable": true,
    "require_integrity": true,
    "require_protocol_alignment": true,
    "require_authority_chain": true,
    "require_communication_integrity": true,
    "require_readiness": true,
    "require_agent_registry": true,
    "require_boot_sequence": true,
    "min_agents_required": 3
  },
  "thresholds": {
    "max_allowed_errors": 3,
    "max_cycle_failures": 2,
    "max_sync_mismatch": 1,
    "critical_failure_level": 1,
    "heartbeat_timeout_seconds": 10,
    "boot_timeout_seconds": 180,
    "max_consecutive_boot_failures": 2,
    "stability_check_interval_seconds": 5
  },
  "checks": {
    "integrity_check_enabled": true,
    "protocol_alignment_check_enabled": true,
    "authority_chain_check_enabled": true,
    "communication_check_enabled": true,
    "readiness_check_enabled": true,
    "checksum_required": true,
    "agent_presence_check_enabled": true,
    "path_validation_enabled": true,
    "circular_dependency_check": true
  },
  "auto_actions": {
    "auto_repair_enabled": true,
    "auto_sync_enabled": true,
    "auto_recover_enabled": true,
    "auto_alert_on_failure": true,
    "auto_log_stability_events": true,
    "auto_rollback_on_critical": true,
    "auto_restart_failed_agents": false
  },
  "failure_responses": {
    "on_integrity_failure": "halt_and_alert",
    "on_protocol_failure": "auto_sync",
    "on_authority_failure": "halt",
    "on_communication_failure": "retry_then_alert",
    "on_readiness_failure": "halt",
    "on_agent_failure": "isolate_and_alert",
    "on_boot_failure": "rollback_and_alert",
    "notify": ["adm_ewitz", "cpt_eco"],
    "alert_channels": ["log", "status_file", "console"],
    "escalation_after_seconds": 30
  },
  "stability_levels": {
    "OPERATIONAL": {"code": 0, "action": "continue"},
    "DEGRADED": {"code": 1, "action": "log_and_continue"},
    "UNSTABLE": {"code": 2, "action": "auto_repair"},
    "CRITICAL": {"code": 3, "action": "halt_and_alert"},
    "OFFLINE": {"code": 4, "action": "emergency_halt"}
  },
  "logging": {
    "log_file": "logs/stability.log",
    "log_level": "INFO",
    "retain_days": 30,
    "alert_on_degraded": true
  }
}
