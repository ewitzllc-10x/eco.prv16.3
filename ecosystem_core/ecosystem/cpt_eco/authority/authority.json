{
  "module": "cpt_eco_authority",
  "version": "1.0.3",
  "description": "Defines authority levels, permissions, and command hierarchy for ecosystem agents.",
  "root_authority": {
    "id": "adm_ewitz",
    "level": 10,
    "role": "Admiral",
    "type": "root_not_agent",
    "override_power": {
      "level": "total",
      "requires": "explicit_reason",
      "requires_audit_log": true,
      "notifies_stability_module": true,
      "cooldown_seconds_after_use": 60
    },
    "permissions": {
      "can_modify_governance": true,
      "can_modify_authority": true,
      "can_modify_protocols": true,
      "can_modify_agents": true,
      "can_shutdown_agents": true
    },
    "limits": {
      "cannot_delete_audit_logs": true,
      "cannot_disable_tamper_protection": true,
      "cannot_self_elevate_other_roots": true,
      "max_governance_changes_per_hour": 5
    }
  },
  "authority_levels": {
    "10": "Admiral",
    "9": "Commander",
    "8": "Captain",
    "5": "Agent",
    "1": "Minimal"
  },
  "permissions": {
    "10": {
      "modify_governance": true,
      "modify_authority": true,
      "modify_protocols": true,
      "shutdown_agents": true,
      "access_all_logs": true
    },
    "9": {
      "modify_governance": false,
      "modify_authority": false,
      "modify_protocols": true,
      "shutdown_agents": false,
      "access_all_logs": true
    },
    "8": {
      "modify_governance": false,
      "modify_authority": false,
      "modify_protocols": false,
      "shutdown_agents": false,
      "access_all_logs": true
    },
    "5": {
      "modify_governance": false,
      "modify_authority": false,
      "modify_protocols": false,
      "shutdown_agents": false,
      "access_all_logs": false
    },
    "1": {
      "modify_governance": false,
      "modify_authority": false,
      "modify_protocols": false,
      "shutdown_agents": false,
      "access_all_logs": false
    }
  },
  "hierarchy_rules": {
    "strict_hierarchy": true,
    "allow_downward_override": true,
    "allow_upward_override": false,
    "conflict_resolution": "delegate_to_stability_module"
  }
}
