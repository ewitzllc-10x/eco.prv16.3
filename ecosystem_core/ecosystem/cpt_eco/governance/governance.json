{
  "module": "cpt_eco_governance",
  "version": "1.0.0",
  "description": "Core governance rules for ecosystem behavior, authority, stability, and protocol compliance.",
  "chain_of_command": {
    "strict": true,
    "enforce_hierarchy": true,
    "allow_bypass": false,
    "root_authority": "adm_ewitz"
  },
  "rules": {
    "ecosystem_integrity_required": true,
    "agents_must_follow_protocols": true,
    "no_agent_can_modify_governance": true,
    "governance_files_are_read_only": true,
    "auto_reject_invalid_requests": true
  },
  "behavior": {
    "conflict_resolution": "delegate_to_stability_module",
    "protocol_validation": "delegate_to_protocols_module",
    "authority_checks": "delegate_to_authority_module",
    "logging": "log_all_governance_actions"
  },
  "governance_cycles": {
    "integrity_check_interval_seconds": 60,
    "protocol_validation_interval_seconds": 30,
    "authority_sync_interval_seconds": 45
  },
  "security": {
    "tamper_protection": true,
    "checksum_validation": true,
    "auto_lock_on_violation": true
  }
}
