{
  "module": "cpt_eco_policies",
  "version": "1.0.1",
  "description": "Defines ecosystem-wide policies, behavioral expectations, safety rules, and operational constraints.",
  "operational_policies": {
    "ecosystem_must_remain_consistent": true,
    "agents_must_follow_chain_of_command": true,
    "protocols_must_be_validated_before_execution": true,
    "authority_checks_required": true,
    "stability_checks_required": true,
    "log_all_critical_actions": true
  },
  "safety_policies": {
    "prevent_unauthorized_modification": true,
    "prevent_upward_override": true,
    "prevent_cross_rank_override": false,
    "allow_downward_override": true,
    "halt_only_if_recovery_fails": true,
    "auto_lock_on_security_violation": true,
    "checksum_required_for_sensitive_operations": true
  },
  "behavioral_policies": {
    "agents_must_report_status": true,
    "agents_must_sync_with_ecosystem_core": true,
    "agents_must_respect_protocol_order": true,
    "agents_must_resolve_conflicts_through_stability_module": true,
    "agents_must_not_modify_governance": true
  },
  "communication_policies": {
    "log_all_inter_agent_messages": true,
    "log_all_protocol_routing": true,
    "allow_emergency_broadcasts": {
      "enabled": true,
      "requires_level": 8
    },
    "restrict_high_authority_channels": true,
    "encrypt_sensitive_traffic": true
  },
  "violation_responses": {
    "minor_violation": "log_and_warn",
    "moderate_violation": "auto_correct_and_log",
    "major_violation": "halt_agent_and_notify_admiral",
    "critical_violation": "ecosystem_lockdown_and_notify_admiral"
  }
}
