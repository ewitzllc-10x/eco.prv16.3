{
  "module": "ecosystem_communication_flow",
  "version": "1.6.3",
  "codename": "pro16v3erbs",
  "description": "Comm flow v1.6.3 - 4-agent business chain adm(10) -> max80(9.5) -> cpt(9) -> 1lt(8) with rank enforcement",

  "chain": {
    "order": ["adm_ewitz", "cmdr_max80", "cpt_eco", "1lt_act"],
    "ranks": {
      "adm_ewitz": 10,
      "cmdr_max80": 9.5,
      "cpt_eco": 9,
      "1lt_act": 8
    },
    "flow": "adm_ewitz(10) -> cmdr_max80(9.5) -> cpt_eco(9) -> 1lt_act(8)"
  },

  "channels": {
    "internal": {
      "enabled": true,
      "encryption": "AES-256",
      "compression": "lz4",
      "description": "Primary internal channel"
    },
    "agent_to_core": {
      "enabled": true,
      "encryption": "AES-256",
      "compression": "lz4",
      "description": "Agents report to core"
    },
    "core_to_agent": {
      "enabled": true,
      "encryption": "AES-256",
      "compression": "lz4",
      "description": "Core commands to agents"
    },
    "agent_to_agent": {
      "enabled": true,
      "encryption": "AES-256",
      "compression": "lz4",
      "description": "Agent chain comm - rank validated",
      "rank_enforced": true,
      "chain": "adm -> max80 -> cpt -> 1lt"
    },
    "command_chain": {
      "enabled": true,
      "encryption": "AES-256",
      "compression": "lz4",
      "description": "Top-down command chain",
      "allowed_routes": [
        "adm_ewitz -> cmdr_max80",
        "adm_ewitz -> cpt_eco",
        "adm_ewitz -> 1lt_act",
        "cmdr_max80 -> cpt_eco",
        "cmdr_max80 -> 1lt_act",
        "cpt_eco -> 1lt_act"
      ]
    },
    "report_chain": {
      "enabled": true,
      "encryption": "AES-256",
      "compression": "lz4",
      "description": "Bottom-up reporting chain",
      "allowed_routes": [
        "1lt_act -> cpt_eco",
        "1lt_act -> cmdr_max80",
        "1lt_act -> adm_ewitz",
        "cpt_eco -> cmdr_max80",
        "cpt_eco -> adm_ewitz",
        "cmdr_max80 -> adm_ewitz"
      ]
    },
    "heartbeat": {
      "enabled": true,
      "encryption": "none",
      "compression": "none",
      "description": "Heartbeat for all 4 agents",
      "agents": ["adm_ewitz", "cmdr_max80", "cpt_eco", "1lt_act"]
    }
  },

  "routing": {
    "use_task_router": true,
    "router_file": "task_router.py",
    "router_class": "TaskRouter",
    "rank_validation": true,
    "enforce_chain": true,
    "description": "All routing via TaskRouter with rank check v1.6.3"
  },

  "flow_rules": {
    "require_encryption": true,
    "require_integrity_check": true,
    "log_all_transmissions": true,
    "allow_agent_to_agent": true,
    "allow_core_to_core": true,
    "allow_agent_to_core": true,
    "allow_core_to_agent": true,
    "rank_enforcement": true,
    "higher_rank_can_command_lower": true,
    "lower_rank_cannot_command_higher": true,
    "cpt_can_command_1lt": true,
    "max80_can_command_cpt_and_1lt": true,
    "adm_can_command_all": true,
    "1lt_reports_to_cpt": true,
    "cpt_reports_to_max80": true,
    "max80_reports_to_adm": true
  },

  "rank_violations": {
    "on_violation": "block_and_log",
    "log": true,
    "notify": "adm_ewitz",
    "fallback": "route_to_commander"
  },

  "fallback": {
    "on_failure": "route_to_stability_engine",
    "fallback_protocol": "stability.check",
    "notify": "adm_ewitz",
    "secondary_notify": "cmdr_max80",
    "description": "Fallback chain: adm -> max80"
  },

  "links": {
    "ecosystem_core": "./ecosystem_core.json",
    "protocol_map": "../protocols/protocol_map.json",
    "agent_registry": "agent_registry.json",
    "stability": "stability.json",
    "authority": "authority.json",
    "hierarchy": "hierarchy.json"
  },

  "integrity": {
    "validate_channels": true,
    "validate_routing": true,
    "validate_links": true,
    "validate_chain": true,
    "log_integrity_checks": true,
    "version": "1.6.3",
    "expected_agents": 4
  }
}
