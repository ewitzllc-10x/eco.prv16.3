{
  "module": "ecosystem_logs",
  "version": "1.6.3",
  "codename": "pro16v3erbs",
  "description": "Defines logging structure, categories, retention rules, routing, and audit requirements for the ecosystem.",
  "last_updated": "2026-05-13",
  "log_categories": {
    "boot": {
      "enabled": true,
      "retention_days": 30,
      "max_file_size_mb": 50,
      "format": "[BOOT::{timestamp}] [{level}] {agent} :: {message}",
      "file": "logs/boot.log",
      "level": "INFO",
      "description": "Logs generated during ecosystem boot sequence."
    },
    "stability": {
      "enabled": true,
      "retention_days": 30,
      "max_file_size_mb": 100,
      "format": "[STABILITY::{timestamp}] [{level}] {check} :: {message}",
      "file": "logs/stability.log",
      "level": "INFO",
      "description": "Logs related to stability checks, failures, and auto-repair actions."
    },
    "readiness": {
      "enabled": true,
      "retention_days": 30,
      "max_file_size_mb": 50,
      "format": "[READINESS::{timestamp}] [{level}] {gate} :: {message}",
      "file": "logs/readiness.log",
      "level": "INFO",
      "description": "Logs for readiness checks, failures, and operational gates."
    },
    "heartbeat": {
      "enabled": true,
      "retention_days": 7,
      "max_file_size_mb": 20,
      "format": "[HEARTBEAT::{timestamp}] {cycle_id} :: {status} :: {message}",
      "file": "logs/heartbeat.log",
      "level": "DEBUG",
      "rotate_hourly": true,
      "description": "Logs emitted by the heartbeat cycle."
    },
    "monitor": {
      "enabled": true,
      "retention_days": 14,
      "max_file_size_mb": 50,
      "format": "[MONITOR::{timestamp}] [{level}] {message}",
      "file": "logs/monitor.log",
      "level": "INFO",
      "description": "Logs generated by the ecosystem monitor."
    },
    "protocol": {
      "enabled": true,
      "retention_days": 30,
      "max_file_size_mb": 100,
      "format": "[PROTOCOL::{timestamp}] [{protocol_id}] {agent} :: {action} :: {message}",
      "file": "logs/protocol.log",
      "level": "INFO",
      "description": "Logs for protocol execution, routing, and validation."
    },
    "agent": {
      "enabled": true,
      "retention_days": 14,
      "max_file_size_mb": 50,
      "format": "[AGENT::{timestamp}] [{agent_id}] {action} :: {message}",
      "file": "logs/agent.log",
      "level": "INFO",
      "description": "Logs related to agent activity, commands, and responses."
    },
    "governance": {
      "enabled": true,
      "retention_days": 90,
      "max_file_size_mb": 100,
      "format": "[GOVERNANCE::{timestamp}] [{level}] {action} :: {actor} :: {message}",
      "file": "logs/governance.audit.log",
      "level": "WARN",
      "description": "Critical governance and authority actions - long retention."
    },
    "authority": {
      "enabled": true,
      "retention_days": 90,
      "max_file_size_mb": 100,
      "format": "[AUTHORITY::{timestamp}] {actor} -> {target} :: {action} :: {message}",
      "file": "logs/authority.log",
      "level": "INFO",
      "description": "Authority usage and override attempts."
    }
  },
  "routing": {
    "boot": "core_channel",
    "stability": "stability_channel",
    "readiness": "core_channel",
    "heartbeat": "observer_channel",
    "monitor": "observer_channel",
    "protocol": "protocol_channel",
    "agent": "agent_channel",
    "governance": "governance_channel",
    "authority": "governance_channel"
  },
  "channels": {
    "core_channel": {"handlers": ["file", "console"], "level": "INFO"},
    "stability_channel": {"handlers": ["file", "console", "alert"], "level": "INFO"},
    "observer_channel": {"handlers": ["file"], "level": "DEBUG"},
    "protocol_channel": {"handlers": ["file", "console"], "level": "INFO"},
    "agent_channel": {"handlers": ["file"], "level": "INFO"},
    "governance_channel": {"handlers": ["file", "console", "alert"], "level": "WARN"}
  },
  "rules": {
    "log_all_categories": true,
    "require_timestamp": true,
    "require_category_format": true,
    "allow_log_escalation": true,
    "strict_log_structure": true,
    "auto_rotate": true,
    "compress_after_days": 7,
    "max_total_log_size_mb": 500
  },
  "audit": {
    "audit_enabled": true,
    "audit_interval_hours": 12,
    "audit_log_integrity": true,
    "audit_protocol_usage": true,
    "audit_authority_actions": true,
    "audit_agent_activity": true,
    "audit_log_rotation": true,
    "notify": ["adm_ewitz", "cpt_eco"],
    "alert_on_governance_violation": true,
    "audit_log_file": "logs/audit.log"
  }
}
